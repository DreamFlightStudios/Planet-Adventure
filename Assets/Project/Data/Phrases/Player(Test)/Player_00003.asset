  AudioClip: {fileID: 8300000, guid: a15e38a60fe0ffb469aaa6bf895308a4, type: 3}
  Text: "\u041D\u0430\u0448\u0430 \u0446\u0435\u043B\u044C \u2014 \u0447\u0442\u043E\u0431\u044B
    \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0435\u043C
    \u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u043E\u0441\u044C
    \u0442\u0430\u043A \u0436\u0435 \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E,
    \u043A\u0430\u043A \u0434\u044B\u0445\u0430\u043D\u0438\u0435, \u0438 \u043F\u043E\u043C\u043E\u0433\u0430\u043B\u043E
    \u0432\u0430\u043C \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u043F\u043E\u0433\u0440\u0443\u0437\u0438\u0442\u044C\u0441\u044F
    \u0432 \u0438\u0441\u0442\u043E\u0440\u0438\u044E."
