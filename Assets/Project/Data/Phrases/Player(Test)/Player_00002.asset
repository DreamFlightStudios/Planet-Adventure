  AudioClip: {fileID: 8300000, guid: 93d469502b69599449448bb80da5baaf, type: 3}
  Text: "\u041C\u044B \u0438\u0437 Mind Flight, \u0438 \u043C\u044B \u0441\u043E\u0437\u0434\u0430\u0435\u043C
    \u044D\u0442\u043E\u0442 \u043A\u0438\u043D\u0435\u043C\u0430\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u043B\u0435\u0440, \u0447\u0442\u043E\u0431\u044B
    \u0433\u0435\u0439\u043C\u043F\u043B\u044D\u0439 \u0432 \u043D\u0430\u0448\u0438\u0445
    \u0432\u0441\u0435\u043B\u0435\u043D\u043D\u044B\u0445 Planet \u0410\u0434\u0432\u0435\u043D\u0447\u0435\u0440
    \u0438 After \u043B\u0430\u0439\u0432\u0441 \u0431\u044B\u043B \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E
    \u043F\u043B\u0430\u0432\u043D\u044B\u043C \u0438 \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u043D\u044B\u043C."
